# Apache: requires mod_deflate and AllowOverride FileInfo.
# These rules do not enable the module on the server; the administrator must do that.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/json application/javascript image/svg+xml
</IfModule>

# Display a useful page for missing URLs while preserving the HTTP 404 status.
ErrorDocument 404 /404.html
